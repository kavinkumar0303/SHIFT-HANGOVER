# Shift Handover Note Generator - Environment Configuration
# Flask App Configuration
FLASK_ENV=production
FLASK_PORT=5050
FLASK_HOST=0.0.0.0
SECRET_KEY=change-this-in-production-to-a-secure-random-secret

# Data Source Overrides (Optional - defaults to data/tickets.json and data/incidents.json)
TICKETS_DATA_PATH=data/tickets.json
INCIDENTS_DATA_PATH=data/incidents.json
OUTPUT_DIR=output

# Future Integration Credentials (Keep empty when using seeded mock data)
JIRA_API_ENDPOINT=
JIRA_API_TOKEN=
PAGERDUTY_API_ENDPOINT=
PAGERDUTY_API_TOKEN=
